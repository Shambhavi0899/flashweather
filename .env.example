# The canonical origin for this deployment. No trailing slash.
#
# Everything SEO reads from it: metadataBase, canonicals, the sitemap, JSON-LD
# and the OG image URLs. Set it per environment -- a preview that canonicalises
# to production is a preview that hands its traffic away, and robots.ts closes
# crawlers out of anything that is not the production origin.
NEXT_PUBLIC_SITE_URL=https://flashweather.ai
